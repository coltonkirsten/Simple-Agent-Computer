# Copy to app/.env and fill in.   cp .env.example .env
# .env is gitignored — never commit it, never paste its contents anywhere.

# --- Google OAuth client -------------------------------------------------------
# Console → Google Auth Platform → Clients → (your Web application client)
# The ID looks like 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# The secret looks like GOCSPX-...   (only shown once at creation; if you lost
# it, add a new secret on the client page and delete the old one)
GOOGLE_CLIENT_SECRET=

# Public URL of this app, no trailing slash. The login callback is
# ${BASE_URL}/auth/callback and must EXACTLY match an "Authorized redirect URI"
# on the OAuth client (scheme, host, port and path).
BASE_URL=http://localhost:3000

# --- Who may log in ------------------------------------------------------------
# Comma-separated Google account emails. Case-insensitive. Anyone not listed
# gets a 403 even after a successful Google login.
ALLOWED_EMAILS=you@gmail.com

# --- Sessions ------------------------------------------------------------------
# Key used to sign + encrypt the session cookie. At least 32 characters.
# Generate one with:   openssl rand -base64 48
# Changing it logs everyone out.
SESSION_SECRET=

# --- Server (optional, defaults shown) -------------------------------------------
# FILE_ROOT=.
# HOST=127.0.0.1
# PORT=3000
# Set to "production" on the VM: turns on Secure cookies and trust-proxy.
# NODE_ENV=development
