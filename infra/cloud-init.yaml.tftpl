#cloud-config
# cloud-init is the standard "configure this machine at boot" tool, and the
# supported way to customise Container-Optimized OS. GCP hands this file to the
# VM through the `user-data` metadata key (see vm.tf). It is re-applied on
# EVERY boot, which matters because /etc on COS is wiped at each reboot.
#
# This is a Terraform template: the dollar-brace placeholders are filled in by
# templatefile() in vm.tf. No secrets pass through here — instance metadata is
# readable by anyone with project viewer access.

users:
  # COS's root home is read-only; docker-credential-gcr needs a writable HOME
  # to store its config. This is the pattern from Google's COS docs.
  - name: cloudservice
    uid: 2000

write_files:
  - path: /etc/sac/config.env
    permissions: "0644"
    content: |
      PROJECT_ID=${project_id}
      REGISTRY_HOST=${registry_host}
      IMAGE=${image}
      BASE_URL=${base_url}

  - path: /etc/sac/start-app.sh
    permissions: "0755"
    content: |
      ${indent(6, start_script)}

  - path: /etc/sac/start-caddy.sh
    permissions: "0755"
    content: |
      ${indent(6, caddy_script)}

  - path: /etc/sac/Caddyfile
    permissions: "0644"
    content: |
      ${indent(6, caddyfile)}

  # A user-defined docker network gives containers DNS by name (Caddy reaches
  # the app as "sac-app") and keeps them off docker's shared default bridge.
  # It's its own oneshot unit so both containers can depend on it without racing.
  - path: /etc/systemd/system/sac-network.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Docker network shared by Caddy and the app
      Wants=docker.service
      After=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/bin/sh -c 'docker network inspect sac-net >/dev/null 2>&1 || docker network create sac-net'

  - path: /etc/systemd/system/sac-caddy.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Caddy reverse proxy (TLS) container
      Requires=sac-network.service
      Wants=network-online.target
      After=sac-network.service network-online.target

      [Service]
      Environment="HOME=/home/cloudservice"
      ExecStart=/bin/bash /etc/sac/start-caddy.sh
      ExecStop=/usr/bin/docker stop sac-caddy
      Restart=always
      RestartSec=15

  - path: /etc/systemd/system/sac-app.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Simple Agent Computer app container
      Requires=sac-network.service
      Wants=network-online.target
      After=sac-network.service network-online.target

      [Service]
      Environment="HOME=/home/cloudservice"
      ExecStart=/bin/bash /etc/sac/start-app.sh
      ExecStop=/usr/bin/docker stop sac-app
      # systemd (not docker) is the supervisor: if the container or the script
      # exits for any reason, wait 15s and start over — including re-fetching
      # secrets and re-pulling the image.
      Restart=always
      RestartSec=15

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl start sac-app.service
  - systemctl start sac-caddy.service
